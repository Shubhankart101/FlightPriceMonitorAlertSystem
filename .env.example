SECRET_KEY=dev-only-secret-key
DJANGO_SETTINGS_MODULE=pulse.settings.local
DB_ENGINE=sqlite
# Set DB_ENGINE=postgres to use Docker Postgres and configure below.
DB_NAME=pulse_db
DB_USER=pulse_user
DB_PASSWORD=pulse_password
DB_HOST=localhost
DB_PORT=5432
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# URL the Celery worker uses to fetch prices. In Docker, use the web service name
# (e.g. http://web:8000/api/flights/price/) instead of localhost.
FLIGHT_PRICE_API_URL=http://localhost:8000/api/flights/price/
FLIGHT_PRICE_API_TIMEOUT=10
